---
import { POSTERS } from '../data/videos';

interface Props {
  posterSrc?: string;
}

const { posterSrc = POSTERS.hero } = Astro.props;
---

<section class="hero hero--video hero--cinematic">
  <div class="hero-media" aria-hidden="true">
    <img
      src={posterSrc}
      alt=""
      class="hero-poster"
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      loading="eager"
    />
  </div>
  <div class="container">
    <div class="hero-content">
      <slot />
    </div>
  </div>
</section>
