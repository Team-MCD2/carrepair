# Configuration Email - Gmail SMTP
# Pour utiliser Gmail:
# 1. Active l'authentification à deux facteurs sur ton compte Gmail
# 2. Crée un "mot de passe d'application" ici: https://myaccount.google.com/apppasswords
# 3. Mets ton adresse Gmail dans EMAIL_USER
# 4. Mets le mot de passe généré dans EMAIL_PASSWORD
# 5. Mets l'adresse email destinataire dans CONTACT_EMAIL

EMAIL_USER=remivint@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_SERVICE=gmail
CONTACT_EMAIL=remivint@gmail.com
