---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page introuvable — Car Repair Toulouse"
  description="La page demandée est introuvable. Retournez à l'accueil du garage Car Repair à Toulouse."
  noindex
>
  <section class="section-padding">
    <div class="container" style="text-align: center; max-width: 640px;">
      <h1 class="section-title" style="display: block;">Page introuvable</h1>
      <p style="color: var(--gris); margin-bottom: 2rem;">
        Désolé, cette page n'existe pas ou a été déplacée.
      </p>
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>
